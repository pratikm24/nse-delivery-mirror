//@version=6
indicator("India FnO Badge + RS", shorttitle = "FnO RS", overlay = true, dynamic_requests = true)

// FnO BADGE (unchanged logic from v2.0)
// Marks a chart "FnO" when TradingView has a LIVE futures feed for it (one request, no stock list).
//   FnO (green) live futures feed | FnO ? (grey) feed stale | No FnO (grey) no feed | FnO - (grey) not checked
//
// 3M RS (new)
// Percentile 1-99 of the stock's 3-month return among the F&O stocks on your Research 360 sector list
// (lowest = 1, highest = 99). Shown under the badge as  "RS <last week> > <now>  <as-of date>".
// A stock is unranked only if NSE lists a split/bonus/consolidation/demerger/arrangement/rights ex-date
// in the window, or it has no price history. Ranking data is computed weekly by a GitHub job and
// written into this script (Pine cannot download data). It turns amber when older than the limit below.
//
// SECTOR TABLE (new, toggle in settings)
// Sector RS = equal-weight average 3M return of the sector's ranked stocks, percentile 1-99 across sectors.
// PINE SCREENER: the script outputs plots (RS now, RS last week, RS change, sector RS now/last week/change)
// so it can be used as a screener filter. Plots are hidden from the chart pane (Data Window / status line only).
//
// 1M RS (new): same method as the 3M RS with a one-month look-back, refreshed daily by a second GitHub job.
// Shown with the 3M RS in one compact table (stock and its sector) and as a 1M column in the sector table.
// "Last wk" is the reading one week before the latest session. The 3M data above is unchanged.
// Generated __GENERATED__ | 3M data as of __ASOF__ (previous week: __PREV__) | 1M data as of __ASOF1M__ (previous week: __PREV1M__)

f_ist(int t) =>
    na(t) ? "n/a" : str.format_time(t, "dd MMM yyyy", "Asia/Kolkata")

string cornerInput = input.string("Middle right", "Corner", options = ["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"])
string sizeInput = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal", "Large"])
bool showOtherInput = input.bool(true, "Show status when FnO is not detected")
color badgeColorInput = input.color(color.rgb(22, 128, 72), "FnO background")
int maxAgeInput = input.int(7, "Max futures data age (days)", minval = 1, maxval = 30, group = "Advanced", tooltip = "How old the latest futures daily bar may be and still count as live. 7 covers weekends and market-holiday clusters.")
string overrideInput = input.string("", "Futures symbol override", group = "Advanced", tooltip = "Usually leave blank. If a stock/index has an unusual futures name, enter its full TradingView symbol, such as NSE:HDFCBANK1! or NSE:FINNIFTY1!. Not needed on a futures/options chart.")

string badgePosition = switch cornerInput
    "Top left" => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left" => position.bottom_left
    "Middle right" => position.middle_right
    "Middle left" => position.middle_left
    => position.top_right

string badgeSize = switch sizeInput
    "Tiny" => size.tiny
    "Normal" => size.normal
    "Large" => size.large
    => size.small

// Delayed charts may identify the exchange as NSE_DLY / BSE_DLY / MCX_DLY.
string exchange = str.replace_all(syminfo.prefix, "_DLY", "")
bool isNseStock = exchange == "NSE" and syminfo.type == "stock"
bool isNseIndex = exchange == "NSE" and syminfo.type == "index"
bool isBseIndex = exchange == "BSE" and syminfo.type == "index"
bool isIndianExchange = exchange == "NSE" or exchange == "BSE" or exchange == "MCX"
bool isDerivativeChart = isIndianExchange and (syminfo.type == "futures" or syminfo.type == "option")
bool checkFutures = isNseStock or isNseIndex or isBseIndex
bool isIndiaStock = (exchange == "NSE" or exchange == "BSE") and syminfo.type == "stock"

// TradingView replaces hyphens and ampersands with underscores in these codes.
string stockCode = str.replace_all(str.replace_all(syminfo.ticker, "-", "_"), "&", "_")
string futuresCode = stockCode

// Cash indices and their futures do not always share a TradingView ticker.
if isNseIndex
    futuresCode := switch stockCode
        "CNXFINANCE" => "FINNIFTY"
        "NIFTY_MID_SELECT" => "MIDCPNIFTY"
        "NIFTYJR" => "NIFTYNXT50"
        "NIFTY_FPI_150" => "NIFTYFPI"
        => stockCode
else if isBseIndex
    futuresCode := switch stockCode
        "SENSEX" => "BSX"
        "BANK" => "BKX"
        => stockCode

string futuresExchange = isBseIndex ? "BSE:" : "NSE:"
string futuresId = overrideInput == "" ? futuresExchange + futuresCode + "1!" : overrideInput

// Single request. calc_bars_count keeps it to the last 10 daily bars of the future.
float fClose = na
int fTime = na
if checkFutures
    [reqClose, reqTime] = request.security(futuresId, "1D", [close, time], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 10)
    fClose := reqClose
    fTime := reqTime

bool hasFeed = not na(fClose) and not na(fTime)
float ageDays = hasFeed ? (timenow - fTime) / 86400000.0 : na
bool liveFeed = hasFeed and ageDays <= maxAgeInput
bool detected = isDerivativeChart or liveFeed

// ----- Index benchmark: 3M return vs a market-cap-based index -----
bool showRelInput = input.bool(true, "Show 3M return vs index under the RS", group = "Index benchmark")
float midMinCrInput = input.float(10000, "Mid-cap starts at market cap (Rs crore)", minval = 0, group = "Index benchmark", tooltip = "Market cap below this uses the small-cap index (this includes stocks under 800 crore).")
float largeMinCrInput = input.float(50000, "Large-cap starts at market cap (Rs crore)", minval = 0, group = "Index benchmark")
string idxSmallInput = input.string("NSE:NIFTYSMLCAP250", "Index for small caps", group = "Index benchmark", tooltip = "Type any TradingView index symbol, e.g. NSE:CNXSMALLCAP (Smallcap 100). To use one index for everything, type the same symbol in all three boxes.")
string idxMidInput = input.string("NSE:CNXMIDCAP", "Index for mid caps", group = "Index benchmark")
string idxLargeInput = input.string("NSE:CNX500", "Index for large caps", group = "Index benchmark")
int refT = timestamp("Asia/Kolkata", year(timenow, "Asia/Kolkata"), month(timenow, "Asia/Kolkata") - 3, dayofmonth(timenow, "Asia/Kolkata"), 0, 0)
var float capCr = na
var string benchSym = ""
var float stkRet = na
var float idxRet = na
var float relPts = na
if barstate.islast and isIndiaStock and showRelInput
    capCr := syminfo.shares_outstanding_total * close / 10000000.0
    benchSym := na(capCr) ? "" : capCr >= largeMinCrInput ? idxLargeInput : capCr >= midMinCrInput ? idxMidInput : idxSmallInput
// Latest prices come from the chart's own last bar (stock) and the index on the same chart timeframe, so both are the latest close on any timeframe.
// The 3-month-ago closes come from daily data, so they do not depend on the chart timeframe. Requests sit at the top level so they run on every bar
// (the index symbol is only filled in on the last bar).
string idxReqSym = benchSym == "" ? syminfo.tickerid : benchSym
float idxNow = request.security(idxReqSym, timeframe.period, close, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 300)
float stkRef = request.security(syminfo.tickerid, "D", ta.valuewhen(time <= refT, close, 0), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 300)
float idxRef = request.security(idxReqSym, "D", ta.valuewhen(time <= refT, close, 0), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = 300)
if barstate.islast and benchSym != ""
    stkRet := (close / stkRef - 1) * 100
    idxRet := (idxNow / idxRef - 1) * 100
    relPts := stkRet - idxRet
plot(relPts, "3M return vs index (pts)", display = display.data_window + display.status_line)

// ----- RS / sector settings -----
bool showRsInput = input.bool(true, "Show 3M RS under the badge", group = "RS")
bool showSectorInput = input.bool(true, "Show sector RS table", group = "RS")
string sectorCornerInput = input.string("Top right", "Sector table corner", options = ["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"], group = "RS")
string sectorSizeInput = input.string("Tiny", "Sector table text size", options = ["Tiny", "Small", "Normal"], group = "RS")
int trendThresholdInput = input.int(10, "RS trend: min weekly change (points)", minval = 1, maxval = 50, group = "RS", tooltip = "Screener column \"RS trend\": 1 = Rising (RS up by at least this many points vs last week), -1 = Falling (down by at least this many), 0 = Stale (smaller change).")
int staleDaysInput = input.int(9, "Mark RS data stale after (days)", minval = 1, maxval = 60, group = "RS", tooltip = "The ranking is refreshed weekly. Older than this and the RS turns amber.")

bool showCompactInput = input.bool(true, "Show compact 1M / 3M RS table", group = "1M RS")
string compactCornerInput = input.string("Middle left", "Compact table corner", options = ["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"], group = "1M RS")
string compactSizeInput = input.string("Small", "Compact table text size", options = ["Tiny", "Small", "Normal"], group = "1M RS")
int stale1mDaysInput = input.int(4, "Mark 1M RS data stale after (days)", minval = 1, maxval = 30, group = "1M RS", tooltip = "The 1M ranking is refreshed every weekday evening. Older than this (covers a weekend plus a holiday) and the 1M figures turn amber.")

string compactPosition = switch compactCornerInput
    "Top right" => position.top_right
    "Top left" => position.top_left
    "Middle right" => position.middle_right
    "Middle left" => position.middle_left
    "Bottom left" => position.bottom_left
    => position.bottom_right
string compactSize = switch compactSizeInput
    "Tiny" => size.tiny
    "Normal" => size.normal
    => size.small

string sectorPosition = switch sectorCornerInput
    "Top right" => position.top_right
    "Top left" => position.top_left
    "Middle right" => position.middle_right
    "Middle left" => position.middle_left
    "Bottom left" => position.bottom_left
    => position.bottom_right
string sectorSize = switch sectorSizeInput
    "Small" => size.small
    "Normal" => size.normal
    => size.tiny

// ----- Data (written by the weekly job; symbols use TradingView's underscore form) -----
string RS_ASOF = "__ASOF__"
string RS_PREV = "__PREV__"
string RS_DATA =
__RS_DATA__
string SEC_DATA =
__SEC_DATA__
string SEC_MEMBERS =
__SEC_MEMBERS__

// ----- 1M data (written by the daily job) -----
string RS1M_ASOF = "__ASOF1M__"
string RS1M_PREV = "__PREV1M__"
string RS1M_DATA =
__RS1M_DATA__
string SEC1M_DATA =
__SEC1M_DATA__

f_rs(string code) =>
    string hay = "," + RS_DATA
    string key = "," + code + ":"
    int p = str.pos(hay, key)
    int cur = na
    int prv = na
    bool found = not na(p)
    if found
        string rest = str.substring(hay, p + str.length(key))
        int e = str.pos(rest, ",")
        string seg = na(e) ? rest : str.substring(rest, 0, e)
        string[] parts = str.split(seg, ">")
        cur := int(str.tonumber(array.get(parts, 0)))
        string pv = array.size(parts) > 1 ? array.get(parts, 1) : "-"
        prv := pv == "-" ? na : int(str.tonumber(pv))
    [found, cur, prv]

f_sector(string code) =>
    string name = ""
    string[] secs = str.split(SEC_MEMBERS, ";")
    for sec in secs
        int eq = str.pos(sec, "=")
        if not na(eq)
            if str.contains(str.substring(sec, eq + 1), "," + code + ",")
                name := str.substring(sec, 0, eq)
    name

f_arrow(int prv, int cur) =>
    na(prv) ? str.tostring(cur) : str.tostring(prv) + " → " + str.tostring(cur)

f_col(int prv, int cur) =>
    na(prv) or na(cur) ? color.white : cur > prv ? color.rgb(76, 217, 130) : cur < prv ? color.rgb(255, 107, 107) : color.white

f_secval(string name) =>
    int cur = na
    int prv = na
    if name != ""
        string[] rows = str.split(SEC_DATA, ";")
        for r in rows
            string[] f = str.split(r, ":")
            if array.get(f, 0) == name
                string[] rv = str.split(array.get(f, 1), ">")
                cur := int(str.tonumber(array.get(rv, 0)))
                string pv = array.get(rv, 1)
                prv := pv == "-" ? na : int(str.tonumber(pv))
    [cur, prv]

// 1M helpers (same lookups as above, on the 1M data strings)
f_rs1m(string code) =>
    string hay = "," + RS1M_DATA
    string key = "," + code + ":"
    int p = str.pos(hay, key)
    int cur = na
    int prv = na
    bool found = not na(p)
    if found
        string rest = str.substring(hay, p + str.length(key))
        int e = str.pos(rest, ",")
        string seg = na(e) ? rest : str.substring(rest, 0, e)
        string[] parts = str.split(seg, ">")
        cur := int(str.tonumber(array.get(parts, 0)))
        string pv = array.size(parts) > 1 ? array.get(parts, 1) : "-"
        prv := pv == "-" ? na : int(str.tonumber(pv))
    [found, cur, prv]

f_secval1m(string name) =>
    int cur = na
    int prv = na
    if name != ""
        string[] rows = str.split(SEC1M_DATA, ";")
        for r in rows
            string[] f = str.split(r, ":")
            if array.get(f, 0) == name
                string[] rv = str.split(array.get(f, 1), ">")
                cur := int(str.tonumber(array.get(rv, 0)))
                string pv = array.get(rv, 1)
                prv := pv == "-" ? na : int(str.tonumber(pv))
    [cur, prv]

f_arrowS(int prv, int cur) =>
    na(cur) ? "–" : f_arrow(prv, cur)

// Computed once per symbol (the symbol does not change across bars).
var bool rsFound = false
var int rsCur = na
var int rsPrv = na
var string mySector = ""
var int secCur = na
var int secPrv = na
var bool rs1mFound = false
var int rs1mCur = na
var int rs1mPrv = na
var int sec1mCur = na
var int sec1mPrv = na
if barstate.isfirst and isNseStock
    [fT, cT, pT] = f_rs(stockCode)
    rsFound := fT
    rsCur := cT
    rsPrv := pT
    mySector := f_sector(stockCode)
    [sC, sP] = f_secval(mySector)
    secCur := sC
    secPrv := sP
    [f1, c1, p1] = f_rs1m(stockCode)
    rs1mFound := f1
    rs1mCur := c1
    rs1mPrv := p1
    [s1C, s1P] = f_secval1m(mySector)
    sec1mCur := s1C
    sec1mPrv := s1P

// Screener / data-window outputs (not drawn on the chart pane)
plot(rsCur, "RS now (1-99)", display = display.data_window + display.status_line)
plot(rsPrv, "RS last week (1-99)", display = display.data_window + display.status_line)
float rsTrend = na(rsCur) or na(rsPrv) ? na : (rsCur - rsPrv >= trendThresholdInput ? 1.0 : rsCur - rsPrv <= -trendThresholdInput ? -1.0 : 0.0)
plot(rsTrend, "RS trend (1 rising, 0 stale, -1 falling)", display = display.data_window + display.status_line)
plot(rsCur - rsPrv, "RS change", display = display.data_window + display.status_line)
plot(secCur, "Sector RS now (1-99)", display = display.data_window + display.status_line)
plot(secPrv, "Sector RS last week (1-99)", display = display.data_window + display.status_line)
plot(secCur - secPrv, "Sector RS change", display = display.data_window + display.status_line)
plot(rs1mCur, "1M RS now (1-99)", display = display.data_window + display.status_line)
plot(rs1mPrv, "1M RS last week (1-99)", display = display.data_window + display.status_line)
plot(rs1mCur - rs1mPrv, "1M RS change", display = display.data_window + display.status_line)
plot(sec1mCur, "Sector 1M RS now (1-99)", display = display.data_window + display.status_line)
plot(sec1mPrv, "Sector 1M RS last week (1-99)", display = display.data_window + display.status_line)
plot(sec1mCur - sec1mPrv, "Sector 1M RS change", display = display.data_window + display.status_line)

int asofTs = timestamp("Asia/Kolkata", int(str.tonumber(str.substring(RS_ASOF, 0, 4))), int(str.tonumber(str.substring(RS_ASOF, 5, 7))), int(str.tonumber(str.substring(RS_ASOF, 8, 10))), 15, 30)
float dataAgeDays = (timenow - asofTs) / 86400000.0
bool rsStale = dataAgeDays > staleDaysInput
string asofShort = str.format_time(asofTs, "dd MMM", "Asia/Kolkata")
int asof1mTs = timestamp("Asia/Kolkata", int(str.tonumber(str.substring(RS1M_ASOF, 0, 4))), int(str.tonumber(str.substring(RS1M_ASOF, 5, 7))), int(str.tonumber(str.substring(RS1M_ASOF, 8, 10))), 15, 30)
float data1mAgeDays = (timenow - asof1mTs) / 86400000.0
bool rs1mStale = data1mAgeDays > stale1mDaysInput
string asof1mShort = str.format_time(asof1mTs, "dd MMM", "Asia/Kolkata")

var table badge = table.new(badgePosition, 1, 3, force_overlay = true)
var table sectorTable = showSectorInput ? table.new(sectorPosition, 3, __NROWS__, force_overlay = true) : na
var table compactTable = showCompactInput and isNseStock ? table.new(compactPosition, 3, 3, force_overlay = true) : na

if barstate.islast
    string badgeText = detected ? "FnO" : checkFutures ? (hasFeed ? "FnO ?" : "No FnO") : "FnO -"
    string badgeTooltip = "Supported: NSE stocks, NSE/BSE indices, and NSE/BSE/MCX futures/options charts."
    if isDerivativeChart
        badgeTooltip := "This is already a " + syminfo.prefix + " futures/options chart.\n" + ticker.standard(syminfo.tickerid) + "\nThe badge marks a derivatives instrument; it does not check whether options exist on its underlying."
    else if liveFeed
        badgeTooltip := "Live futures feed found on TradingView.\nChecked: " + futuresId + "\nLatest futures bar: " + f_ist(fTime) + " (" + str.tostring(ageDays, "#.#") + " days old, limit " + str.tostring(maxAgeInput) + ")\nThis is a feed-based check, not an official eligibility flag."
    else if checkFutures and hasFeed
        badgeTooltip := "A futures feed exists but looks stale.\nChecked: " + futuresId + "\nLatest futures bar: " + f_ist(fTime) + " (" + str.tostring(ageDays, "#.#") + " days old, limit " + str.tostring(maxAgeInput) + ")\nThe stock may have left F&O, or the feed is delayed."
    else if checkFutures
        badgeTooltip := "No futures feed found under this name.\nChecked: " + futuresId + "\nChart: " + ticker.standard(syminfo.tickerid) + "\nEither the stock is not in F&O, or its futures use a different TradingView name (use the override input).\nThis is not an official eligibility flag."
    bool visibleBadge = detected or showOtherInput
    table.cell(badge, 0, 0, text = visibleBadge ? badgeText : "", text_color = color.white, text_size = badgeSize, bgcolor = visibleBadge ? (detected ? badgeColorInput : color.new(color.gray, 25)) : color.new(color.white, 100), tooltip = visibleBadge ? badgeTooltip : "")

    // RS row (NSE stocks only)
    if showRsInput and isNseStock and visibleBadge
        color amber = color.rgb(214, 158, 46)
        string rsText = "RS –"
        string rsTip = "Not ranked.\nEither this stock is not on the F&O sector list used, or it is excluded (NSE split/bonus/rights ex-date in the 3-month window, or too little price history)."
        color rsBg = color.new(color.gray, 25)
        color rsTxt = color.white
        if rsFound
            rsText := "RS " + f_arrow(rsPrv, rsCur) + "  " + asofShort + (rsStale ? " ⚠" : "")
            rsTxt := f_col(rsPrv, rsCur)
            rsBg := rsStale ? color.new(amber, 25) : color.new(#131722, 10)
            rsTip := "3M relative strength, percentile 1-99 among F&O stocks (higher = stronger).\nLast week (" + RS_PREV + "): " + (na(rsPrv) ? "not ranked" : str.tostring(rsPrv)) + "\nNow (" + RS_ASOF + "): " + str.tostring(rsCur) + (mySector != "" ? "\nSector: " + mySector : "") + (rsStale ? "\nDATA IS " + str.tostring(dataAgeDays, "#") + " DAYS OLD: refresh the script." : "")
        table.cell(badge, 0, 1, text = rsText, text_color = rsStale ? color.white : rsTxt, text_size = badgeSize, bgcolor = rsBg, tooltip = rsTip)
    else
        table.cell(badge, 0, 1, text = "", bgcolor = color.new(color.white, 100))

    // Index-relative row (NSE stocks only)
    if showRelInput and isIndiaStock
        string relText = ""
        string relTip = ""
        color relBg = color.new(color.white, 100)
        color relTxt = color.white
        if na(capCr)
            relText := "vs idx –"
            relTip := "Market cap is not available on TradingView for this stock, so no benchmark index could be chosen."
            relBg := color.new(color.gray, 25)
        else if not na(relPts)
            relText := "vs idx " + (relPts >= 0 ? "+" : "") + str.tostring(relPts, "#.#")
            relTxt := relPts >= 0 ? color.rgb(76, 217, 130) : color.rgb(255, 107, 107)
            relBg := color.new(#131722, 10)
            relTip := "3M return vs benchmark index, in percentage points (stock minus index).\nStock 3M: " + str.tostring(stkRet, "#.#") + "%   Index 3M: " + str.tostring(idxRet, "#.#") + "%\nIndex used: " + benchSym + "\nMarket cap: about Rs " + str.tostring(capCr, "#,###") + " crore (shares outstanding x price)"
        else
            relText := "vs idx –"
            relTip := "Index data not found for " + benchSym + ". Check the symbol in settings."
            relBg := color.new(color.gray, 25)
        table.cell(badge, 0, 2, text = relText, text_color = relTxt, text_size = badgeSize, bgcolor = relBg, tooltip = relTip)
    else
        table.cell(badge, 0, 2, text = "", bgcolor = color.new(color.white, 100))

    // Compact 1M / 3M RS table (NSE stocks): stock row and sector row, last week -> now
    if showCompactInput and isNseStock
        color amberC = color.rgb(214, 158, 46)
        color hdrBg = color.new(#131722, 10)
        color rowBg = color.new(#131722, 25)
        table.cell(compactTable, 0, 0, text = "RS", text_color = color.white, text_size = compactSize, bgcolor = hdrBg, text_halign = text.align_left)
        table.cell(compactTable, 1, 0, text = "1M  " + asof1mShort + (rs1mStale ? " ⚠" : ""), text_color = rs1mStale ? amberC : color.rgb(170, 170, 170), text_size = compactSize, bgcolor = hdrBg, tooltip = "1M RS data as of " + RS1M_ASOF + ". Last wk = " + RS1M_PREV + (rs1mStale ? "\nDATA IS " + str.tostring(data1mAgeDays, "#") + " DAYS OLD: refresh the script." : ""))
        table.cell(compactTable, 2, 0, text = "3M  " + asofShort + (rsStale ? " ⚠" : ""), text_color = rsStale ? amberC : color.rgb(170, 170, 170), text_size = compactSize, bgcolor = hdrBg, tooltip = "3M RS data as of " + RS_ASOF + ". Last wk = " + RS_PREV + (rsStale ? "\nDATA IS " + str.tostring(dataAgeDays, "#") + " DAYS OLD: refresh the script." : ""))
        table.cell(compactTable, 0, 1, text = "Stock", text_color = color.white, text_size = compactSize, bgcolor = rowBg, text_halign = text.align_left)
        table.cell(compactTable, 1, 1, text = rs1mFound ? f_arrow(rs1mPrv, rs1mCur) : "–", text_color = rs1mFound ? (rs1mStale ? amberC : f_col(rs1mPrv, rs1mCur)) : color.white, text_size = compactSize, bgcolor = rowBg, tooltip = rs1mFound ? "1M RS, percentile 1-99 among F&O stocks (higher = stronger). Last week: " + (na(rs1mPrv) ? "not ranked" : str.tostring(rs1mPrv)) + ", now: " + str.tostring(rs1mCur) : "Not ranked on 1M (not on the F&O list used, NSE split/bonus/rights ex-date in the 1-month window, or no price data).")
        table.cell(compactTable, 2, 1, text = rsFound ? f_arrow(rsPrv, rsCur) : "–", text_color = rsFound ? (rsStale ? amberC : f_col(rsPrv, rsCur)) : color.white, text_size = compactSize, bgcolor = rowBg, tooltip = rsFound ? "3M RS, percentile 1-99 among F&O stocks (higher = stronger). Last week: " + (na(rsPrv) ? "not ranked" : str.tostring(rsPrv)) + ", now: " + str.tostring(rsCur) : "Not ranked on 3M.")
        table.cell(compactTable, 0, 2, text = "Sector", text_color = color.white, text_size = compactSize, bgcolor = rowBg, text_halign = text.align_left, tooltip = mySector != "" ? mySector : "Sector not found")
        table.cell(compactTable, 1, 2, text = f_arrowS(sec1mPrv, sec1mCur), text_color = na(sec1mCur) ? color.white : (rs1mStale ? amberC : f_col(sec1mPrv, sec1mCur)), text_size = compactSize, bgcolor = rowBg, tooltip = mySector)
        table.cell(compactTable, 2, 2, text = f_arrowS(secPrv, secCur), text_color = na(secCur) ? color.white : (rsStale ? amberC : f_col(secPrv, secCur)), text_size = compactSize, bgcolor = rowBg, tooltip = mySector)

    // Sector table (1M and 3M columns)
    if showSectorInput
        string[] rows = str.split(SEC_DATA, ";")
        table.cell(sectorTable, 0, 0, text = "Sector RS  (last wk → now)", text_color = color.white, text_size = sectorSize, bgcolor = color.new(#131722, 10), text_halign = text.align_left)
        table.cell(sectorTable, 1, 0, text = "1M " + asof1mShort + (rs1mStale ? " ⚠" : ""), text_color = rs1mStale ? color.rgb(214, 158, 46) : color.rgb(170, 170, 170), text_size = sectorSize, bgcolor = color.new(#131722, 10))
        table.cell(sectorTable, 2, 0, text = "3M " + asofShort + (rsStale ? " ⚠" : ""), text_color = rsStale ? color.rgb(214, 158, 46) : color.rgb(170, 170, 170), text_size = sectorSize, bgcolor = color.new(#131722, 10))
        for i = 0 to array.size(rows) - 1
            string[] f = str.split(array.get(rows, i), ":")
            string nm = array.get(f, 0)
            string[] rv = str.split(array.get(f, 1), ">")
            int cur = int(str.tonumber(array.get(rv, 0)))
            string pv = array.get(rv, 1)
            int prv = pv == "-" ? na : int(str.tonumber(pv))
            int cnt = int(str.tonumber(array.get(f, 2)))
            [cur1, prv1] = f_secval1m(nm)
            bool mine = nm == mySector
            color bg = mine ? color.new(color.rgb(41, 98, 255), 35) : color.new(#131722, 25)
            table.cell(sectorTable, 0, i + 1, text = nm + (cnt <= 2 ? " *" : ""), text_color = color.white, text_size = sectorSize, bgcolor = bg, text_halign = text.align_left, tooltip = str.tostring(cnt) + " ranked stock(s)")
            table.cell(sectorTable, 1, i + 1, text = f_arrowS(prv1, cur1), text_color = na(cur1) ? color.white : f_col(prv1, cur1), text_size = sectorSize, bgcolor = bg, text_halign = text.align_right)
            table.cell(sectorTable, 2, i + 1, text = f_arrow(prv, cur), text_color = f_col(prv, cur), text_size = sectorSize, bgcolor = bg, text_halign = text.align_right)
        table.cell(sectorTable, 0, array.size(rows) + 1, text = "* only 1-2 stocks: noisy", text_color = color.rgb(170, 170, 170), text_size = sectorSize, bgcolor = color.new(#131722, 25), text_halign = text.align_left)
        table.cell(sectorTable, 1, array.size(rows) + 1, text = "", bgcolor = color.new(#131722, 25))
        table.cell(sectorTable, 2, array.size(rows) + 1, text = "", bgcolor = color.new(#131722, 25))
